{
  "name": "@mindskit/thai",
  "version": "0.0.0",
  "private": true,
  "description": "A lightweight TypeScript toolkit for Thai language processing, including romanization, text segmentation, normalization, and more.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": { "node": ">=24" },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./normalization": {
      "types": "./dist/normalization/index.d.ts",
      "default": "./dist/normalization/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build": "tsdown"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}

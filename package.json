{
  "name": "@mindskit/thai",
  "version": "0.0.1",
  "private": true,
  "description": "A lightweight TypeScript toolkit for Thai language processing, including romanization, text segmentation, normalization, and more.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./analysis": {
      "types": "./dist/analysis/index.d.mts",
      "default": "./dist/analysis/index.mjs"
    },
    "./dictionary": {
      "types": "./dist/dictionary/index.d.mts",
      "default": "./dist/dictionary/index.mjs"
    },
    "./normalization": {
      "types": "./dist/normalization/index.d.mts",
      "default": "./dist/normalization/index.mjs"
    },
    "./numbers": {
      "types": "./dist/numbers/index.d.mts",
      "default": "./dist/numbers/index.mjs"
    },
    "./romanization": {
      "types": "./dist/romanization/index.d.mts",
      "default": "./dist/romanization/index.mjs"
    },
    "./segmentation": {
      "types": "./dist/segmentation/index.d.mts",
      "default": "./dist/segmentation/index.mjs"
    },
    "./spell-checking": {
      "types": "./dist/spell-checking/index.d.mts",
      "default": "./dist/spell-checking/index.mjs"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build": "tsdown"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
